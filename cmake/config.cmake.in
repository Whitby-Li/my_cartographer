@PACKAGE_INIT@

# 设置头文件路径变量
set(my_cartographer_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")

find_dependency(absl REQUIRED COMPONENTS base strings time memory synchronization)
find_dependency(Protobuf REQUIRED)
find_dependency(Eigen3 REQUIRED)
find_dependency(Ceres REQUIRED)
find_dependency(Boost REQUIRED COMPONENTS iostreams)

# 加载导出的 targets
include("${CMAKE_CURRENT_LIST_DIR}/my_cartographerTargets.cmake")